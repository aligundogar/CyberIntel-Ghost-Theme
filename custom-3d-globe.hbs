{{!< default}}

{{!-- 
This is a custom template for a "3D Cyber Globe" page.
It integrates Three.js and Globe.gl to render an interactive 3D Earth,
visualizing real-time or mocked threat feeds (like the Iran OSINT JSON data).
--}}

<div class="gh-page cyber-globe-page">
    <div id="globeViz"></div>

    <div class="cyber-globe-overlay">
        <header class="globe-header">
            <h1 class="globe-title"><span class="cyber-status-dot flash"></span> GLOBAL OSINT APEX</h1>
            <p class="globe-subtitle">Live Threat Architecture & Geopolitical Feeds</p>
        </header>
        
        <div class="globe-stats">
            <div class="stat-box">
                <span class="stat-label">ACTIVE NODES</span>
                <span class="stat-value" id="nodeCount">0</span>
            </div>
            <div class="stat-box">
                <span class="stat-label">VECTORS</span>
                <span class="stat-value" id="threatCount">0</span>
            </div>
            <div class="stat-box">
                <span class="stat-label">STATUS</span>
                <span class="stat-value text-red">DEFCON 2</span>
            </div>
        </div>
        
        <div class="globe-feed" id="globeFeed">
            <div class="feed-header">>> INCOMING LOGS</div>
            <div class="feed-content" id="feedContent">
                <!-- Data populated by JS -->
            </div>
        </div>
    </div>
</div>

{{#contentFor "scripts"}}
<script src="//unpkg.com/three"></script>
<script src="//unpkg.com/globe.gl"></script>
<style>
/* CSS for the Cyber Globe Page */
.cyber-globe-page {
    position: relative;
    width: 100vw;
    height: 100vh;
    margin-top: -6vmin; /* Pull up to hide normal margins */
    left: 50%;
    transform: translateX(-50%);
    overflow: hidden;
    background: #000;
}
#globeViz {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}
.cyber-globe-overlay {
    position: absolute;
    top: 40px;
    left: 4vmin;
    z-index: 10;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100vh - 120px);
}
.globe-header {
    background: rgba(10, 10, 15, 0.7);
    border: 1px solid rgba(0, 255, 65, 0.3);
    padding: 2rem;
    border-radius: 4px;
    backdrop-filter: blur(5px);
    width: 350px;
}
.globe-title {
    font-size: 1.6rem;
    font-family: var(--font-mono);
    color: #fff;
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 10px;
}
.flash { animation: pulse 1s infinite alternate; }
@keyframes pulse {
    0% { opacity: 1; box-shadow: 0 0 10px var(--color-red); }
    100% { opacity: 0.3; box-shadow: 0 0 2px var(--color-red); }
}
.globe-subtitle {
    font-size: 1.2rem;
    color: var(--color-green);
    margin: 0;
}
.globe-stats {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
}
.stat-box {
    background: rgba(10, 10, 15, 0.7);
    border-left: 3px solid var(--color-red);
    padding: 1rem 1.5rem;
    width: 130px;
    backdrop-filter: blur(5px);
}
.stat-box:nth-child(even) { border-color: var(--color-green); }
.stat-label {
    display: block;
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
}
.stat-value {
    display: block;
    font-size: 2.2rem;
    color: #fff;
    font-weight: 700;
}
.text-red { color: var(--color-red) !important; font-size: 1.6rem; padding-top: 5px; }

.globe-feed {
    width: 350px;
    background: rgba(10, 10, 15, 0.7);
    border: 1px solid rgba(147, 51, 234, 0.3);
    backdrop-filter: blur(5px);
    display: flex;
    flex-direction: column;
}
.feed-header {
    background: rgba(147, 51, 234, 0.2);
    color: #fff;
    font-family: var(--font-mono);
    padding: 1rem;
    font-size: 1.2rem;
    font-weight: bold;
}
.feed-content {
    height: 350px;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    pointer-events: auto; /* allow scrolling */
}
.feed-content::-webkit-scrollbar { width: 4px; }
.feed-content::-webkit-scrollbar-thumb { background: var(--color-purple); }
.feed-item {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    border-bottom: 1px dotted rgba(255,255,255,0.1);
    padding-bottom: 1rem;
}
.feed-item .date { color: var(--color-red); display: block; margin-bottom: 4px;}
.feed-item .title { color: #fff;}

@media (max-width: 800px) {
    .cyber-globe-overlay {
        top: auto;
        bottom: 20px;
        height: auto;
        left: 20px;
        right: 20px;
    }
    .globe-feed { display: none; }
    .globe-header { width: auto; }
}
</style>
<script>
document.addEventListener("DOMContentLoaded", () => {
    const vizContainer = document.getElementById('globeViz');
    
    // 1. Globe Implementation
    const world = Globe()
      (vizContainer)
      .globeImageUrl('//unpkg.com/three-globe/example/img/earth-night.jpg')
      .bumpImageUrl('//unpkg.com/three-globe/example/img/earth-topology.png')
      .backgroundImageUrl('//unpkg.com/three-globe/example/img/night-sky.png')
      .showAtmosphere(true)
      .atmosphereColor('#9333ea')
      .atmosphereAltitude(0.15);

    // Make the globe auto-rotate and zoom out slightly
    world.controls().autoRotate = true;
    world.controls().autoRotateSpeed = 1.0;
    
    // Set initial position pointing roughly at Middle East
    world.pointOfView({ lat: 32, lng: 53, altitude: 2 });

    // 2. Generate Data for Iran/Geopolitics
    // Center cluster around Iran (lat 32.4, lng 53.6)
    const N = 45;
    const arcsData = [...Array(N).keys()].map(() => {
        // Source points mostly in Iran
        const srcLat = 32.4279 + (Math.random() - 0.5) * 15;
        const srcLng = 53.6880 + (Math.random() - 0.5) * 15;
        
        // Target points around the world
        const tgtLat = (Math.random() - 0.5) * 160;
        const tgtLng = (Math.random() - 0.5) * 360;

        return {
            startLat: srcLat,
            startLng: srcLng,
            endLat: tgtLat,
            endLng: tgtLng,
            color: Math.random() > 0.5 ? ['#ff3e3e', '#ff3e3e'] : ['#00ff41', '#00ff41']
        };
    });

    world.arcsData(arcsData)
         .arcColor('color')
         .arcDashLength(() => Math.random() * 0.5 + 0.1)
         .arcDashGap(() => Math.random() * 0.5 + 0.5)
         .arcDashAnimateTime(() => Math.random() * 4000 + 1000)
         .arcStroke(0.8);

    // 3. Stats update
    document.getElementById('nodeCount').innerText = N * 2;
    document.getElementById('threatCount').innerText = N;

    // 4. Mock Feed from 'Tehran Times' JSON format
    const mockFeeds = [
        "U.S.-Israeli strikes keep targeting emergency teams",
        "War threatens fragile ecosystems of Persian Gulf",
        "Bombed Iranian girls school had yearslong online presence",
        "Trump administration in disarray: How Washington miscalculated",
        "US aircraft losses mount as Washington struggles to contain narrative",
        "America's economy, industrial base weren't built for this war",
        "Mexican academics express sympathy, solidarity with Iranian nation"
    ];

    const feedContent = document.getElementById('feedContent');
    mockFeeds.forEach(t => {
        const div = document.createElement('div');
        div.className = 'feed-item';
        // Randomize the time slightly for effect
        const randomTime = new Date(Date.now() - Math.random() * 10000000).toISOString().split('T')[1].slice(0,8);
        div.innerHTML = `<span class="date">[${randomTime}] SYS.LOG</span><span class="title">${t}</span>`;
        feedContent.appendChild(div);
    });

    // Make it responsive
    const updateSize = () => {
        world.width(window.innerWidth).height(window.innerHeight);
    };
    window.addEventListener('resize', updateSize);
    updateSize(); // Initial call
});
</script>
{{/contentFor}}
