{{!< default}}

{{!-- 
This is a custom template for a "3D Cyber Globe" page.
It integrates Three.js and Globe.gl to render an interactive 3D Earth,
visualizing real-time or mocked threat feeds (like the Iran OSINT JSON data).
--}}

<div class="gh-page cyber-globe-page">
    <div id="globeViz"></div>

    <div class="cyber-globe-overlay">
        <header class="globe-header">
            <h1 class="globe-title"><span class="cyber-status-dot flash"></span> GLOBAL OSINT APEX</h1>
            <p class="globe-subtitle">Live Threat Architecture & Geopolitical Feeds</p>
        </header>
        
        <div class="globe-stats">
            <div class="stat-box">
                <span class="stat-label">ACTIVE NODES</span>
                <span class="stat-value" id="nodeCount">0</span>
            </div>
            <div class="stat-box">
                <span class="stat-label">VECTORS</span>
                <span class="stat-value" id="threatCount">0</span>
            </div>
            <div class="stat-box">
                <span class="stat-label">STATUS</span>
                <span class="stat-value text-red">DEFCON 2</span>
            </div>
        </div>
        
        <div class="globe-feed" id="globeFeed">
            <div class="feed-header">>> INCOMING LOGS</div>
            <div class="feed-content" id="feedContent">
                <!-- Data populated by JS -->
            </div>
        </div>
    </div>
</div>

{{#contentFor "scripts"}}
<script src="{{asset "js/geodata.js"}}"></script>
<script src="//unpkg.com/three"></script>
<script src="//unpkg.com/globe.gl"></script>
<style>
/* CSS for the Cyber Globe Page */
.cyber-globe-page {
    position: relative;
    width: 100vw;
    height: 100vh;
    margin-top: -6vmin; /* Pull up to hide normal margins */
    left: 50%;
    transform: translateX(-50%);
    overflow: hidden;
    background: #000;
}
#globeViz {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}
.cyber-globe-overlay {
    position: absolute;
    top: 40px;
    left: 4vmin;
    z-index: 10;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100vh - 120px);
}
.globe-header {
    background: rgba(10, 10, 15, 0.7);
    border: 1px solid rgba(0, 255, 65, 0.3);
    padding: 2rem;
    border-radius: 4px;
    backdrop-filter: blur(5px);
    width: 350px;
}
.globe-title {
    font-size: 1.6rem;
    font-family: var(--font-mono);
    color: #fff;
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 10px;
}
.flash { animation: pulse 1s infinite alternate; }
@keyframes pulse {
    0% { opacity: 1; box-shadow: 0 0 10px var(--color-red); }
    100% { opacity: 0.3; box-shadow: 0 0 2px var(--color-red); }
}
.globe-subtitle {
    font-size: 1.2rem;
    color: var(--color-green);
    margin: 0;
}
.globe-stats {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
}
.stat-box {
    background: rgba(10, 10, 15, 0.7);
    border-left: 3px solid var(--color-red);
    padding: 1rem 1.5rem;
    width: 130px;
    backdrop-filter: blur(5px);
}
.stat-box:nth-child(even) { border-color: var(--color-green); }
.stat-label {
    display: block;
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
}
.stat-value {
    display: block;
    font-size: 2.2rem;
    color: #fff;
    font-weight: 700;
}
.text-red { color: var(--color-red) !important; font-size: 1.6rem; padding-top: 5px; }

.globe-feed {
    width: 350px;
    background: rgba(10, 10, 15, 0.7);
    border: 1px solid rgba(147, 51, 234, 0.3);
    backdrop-filter: blur(5px);
    display: flex;
    flex-direction: column;
}
.feed-header {
    background: rgba(147, 51, 234, 0.2);
    color: #fff;
    font-family: var(--font-mono);
    padding: 1rem;
    font-size: 1.2rem;
    font-weight: bold;
}
.feed-content {
    height: 350px;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    pointer-events: auto; /* allow scrolling */
}
.feed-content::-webkit-scrollbar { width: 4px; }
.feed-content::-webkit-scrollbar-thumb { background: var(--color-purple); }
.feed-item {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    border-bottom: 1px dotted rgba(255,255,255,0.1);
    padding-bottom: 1rem;
}
.feed-item .date { color: var(--color-red); display: block; margin-bottom: 4px;}
.feed-item .title { color: #fff;}

@media (max-width: 800px) {
    .cyber-globe-overlay {
        top: auto;
        bottom: 20px;
        height: auto;
        left: 20px;
        right: 20px;
    }
    .globe-feed { display: none; }
    .globe-header { width: auto; }
}
</style>
<script>
document.addEventListener("DOMContentLoaded", () => {
    const vizContainer = document.getElementById('globeViz');
    
    // 1. Globe Implementation
    const world = Globe()
      (vizContainer)
      .globeImageUrl('//unpkg.com/three-globe/example/img/earth-night.jpg')
      .bumpImageUrl('//unpkg.com/three-globe/example/img/earth-topology.png')
      .backgroundImageUrl('//unpkg.com/three-globe/example/img/night-sky.png')
      .showAtmosphere(true)
      .atmosphereColor('#9333ea')
      .atmosphereAltitude(0.15);

    world.controls().autoRotate = true;
    world.controls().autoRotateSpeed = 1.0;
    world.pointOfView({ lat: 32, lng: 53, altitude: 2 }); // Initial view at Middle East

    // Get coords dictionary from geodata.js payload
    const countryCoords = window.GHOST_GEO_DICT || {};

    // 2. Fetch Data from Ghost Content API
    const API_KEY = '{{@custom.content_api_key}}';
    const GHOST_URL = '{{@site.url}}';
    
    // Fallback Mock Feeds
    const mockFeeds = [
        "Awaiting API connection...",
        "To enable live data, please enter your Content API Key in the Theme Settings.",
        "Currently running in DEMO mode."
    ];
    let feedContainer = document.getElementById('feedContent');

    if (!API_KEY || API_KEY === '') {
        mockFeeds.forEach(t => {
            const div = document.createElement('div');
            div.className = 'feed-item';
            div.innerHTML = `<span class="date">[SYS.ERR]</span><span class="title" style="color:var(--color-red)">${t}</span>`;
            feedContainer.appendChild(div);
        });
        document.getElementById('nodeCount').innerText = "0";
        document.getElementById('threatCount').innerText = "0";
    } else {
        // Fetch posts published in the last 7 days
        const limitDays = 7;
        const cutoffDate = new Date();
        cutoffDate.setDate(cutoffDate.getDate() - limitDays);
        const isoCutoff = cutoffDate.toISOString().split('.')[0] + 'Z'; 
        // Ghost Content API filter syntax: published_at:>'2023-01-01T00:00:00Z'
        
        const fetchUrl = `${GHOST_URL}/ghost/api/content/posts/?key=${API_KEY}&filter=published_at:>'${isoCutoff}'&include=tags&limit=100`;

        fetch(fetchUrl)
            .then(res => res.json())
            .then(data => {
                if(data.errors) {
                    console.error("Ghost API Error: ", data.errors);
                    return;
                }
                const posts = data.posts || [];
                
                let pointsData = [];
                let arcsData = [];
                
                // Keep the Middle East as the center of operations
                const srcLat = 32.4279;
                const srcLng = 53.6880;

                posts.forEach(post => {
                    // Populate feed
                    const div = document.createElement('div');
                    div.className = 'feed-item';
                    const pubDate = new Date(post.published_at).toISOString().split('T')[1].slice(0,8);
                    div.innerHTML = `<span class="date">[${pubDate}] SYS.LOG</span><span class="title"><a href="${post.url}" target="_blank" style="color:#fff; text-decoration:none;">${post.title}</a></span>`;
                    feedContainer.appendChild(div);

                    // Check tags for country coords
                    if(post.tags && post.tags.length > 0) {
                        post.tags.forEach(tag => {
                            let slug = tag.slug.toLowerCase();
                            if(countryCoords[slug]) {
                                let coords = countryCoords[slug];
                                
                                // Add Dot
                                pointsData.push({
                                    lat: coords.lat + (Math.random() - 0.5) * 2, // Slight scatter
                                    lng: coords.lng + (Math.random() - 0.5) * 2,
                                    size: 1.5,
                                    color: ['ir', 'iran', 'palestine', 'syria'].includes(slug) ? '#00ff41' : '#ff3e3e',
                                    name: tag.name
                                });

                                // Add Arc from center to point
                                arcsData.push({
                                    startLat: srcLat,
                                    startLng: srcLng,
                                    endLat: coords.lat,
                                    endLng: coords.lng,
                                    color: ['ir', 'iran', 'palestine', 'syria'].includes(slug) ? ['#00ff41', '#00ff41'] : ['#ff3e3e', '#ff3e3e']
                                });
                            }
                        });
                    }
                });

                // Render Points & Arcs
                world.pointsData(pointsData)
                     .pointColor('color')
                     .pointAltitude(0.01)
                     .pointRadius('size')
                     .pointsMerge(false);

                world.arcsData(arcsData)
                     .arcColor('color')
                     .arcDashLength(() => 0.4)
                     .arcDashGap(() => 0.2)
                     .arcDashAnimateTime(() => Math.random() * 4000 + 1000)
                     .arcStroke(0.6);

                // Update Stats
                document.getElementById('nodeCount').innerText = pointsData.length;
                document.getElementById('threatCount').innerText = arcsData.length;
            })
            .catch(err => {
                console.error("Failed to fetch feed: ", err);
            });
    }

    // Make it responsive
    const updateSize = () => {
        world.width(window.innerWidth).height(window.innerHeight);
    };
    window.addEventListener('resize', updateSize);
    updateSize(); // Initial call
});
</script>
{{/contentFor}}
