<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{asset "built/index.css"}}" />
    <script src="{{asset "built/index.js"}}" defer></script>

    <title>{{meta_title}}</title>

    {{ghost_head}}

</head>

<body class="{{body_class}}" data-theme="dark">
<div class="gh-viewport">

<header id="gh-head" class="gh-head">
    <nav class="gh-head-inner gh-container">
        <div class="gh-head-brand">
            <a class="gh-head-logo" href="{{@site.url}}">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}" />
                {{else}}
                    <span class="cyber-logo-text">{{@site.title}}</span>
                {{/if}}
            </a>
            <a class="gh-burger" role="button">
                <div class="gh-burger-box">
                    <div class="gh-burger-inner"></div>
                </div>
            </a>
        </div>
        <div class="gh-head-menu">
            {{navigation}}
        </div>
        <div class="gh-head-actions">
            <div class="gh-head-actions-list">
                {{#if @site.facebook}}
                <a href="{{social_url type='facebook'}}" title="Facebook" target="_blank" rel="noopener">{{> "icons/facebook"}}</a>
                {{/if}}
                {{#if @site.twitter}}
                <a href="{{social_url type='twitter'}}" title="Twitter" target="_blank" rel="noopener">{{> "icons/twitter"}}</a>
                {{/if}}
                <a href="https://feedly.com/i/subscription/feed/{{@site.url}}/rss/" title="RSS" target="_blank" rel="noopener">{{> "icons/rss"}}</a>
            </div>
        </div>
    </nav>
</header>

<main class="gh-main">

    <section class="gh-page gh-error cyber-error">
        <div class="gh-container">

            <section class="gh-error-content">
                <div class="cyber-error-terminal">
                    <div class="cyber-error-header">
                        <span class="cyber-dot cyber-dot-red"></span>
                        <span class="cyber-dot cyber-dot-yellow"></span>
                        <span class="cyber-dot cyber-dot-green"></span>
                        <span class="cyber-error-title">terminal</span>
                    </div>
                    <div class="cyber-error-body">
                        <p class="cyber-error-prompt"><span class="cyber-prompt">$&gt;</span> scan --target "{{@site.url}}"</p>
                        <p class="cyber-error-prompt"><span class="cyber-prompt-warn">[!]</span> ERROR: <span class="cyber-error-code">{{statusCode}}</span></p>
                        <p class="cyber-error-prompt"><span class="cyber-prompt-err">[✗]</span> {{message}}</p>
                        <p class="cyber-error-prompt"><span class="cyber-prompt">$&gt;</span> <a href="{{@site.url}}" class="cyber-error-link-text">{{t "Back to home"}}<span class="cyber-terminal-cursor">_</span></a></p>
                    </div>
                </div>

                {{#if errorDetails}}
                <section class="gh-error-stack">
                    <h4>{{t "Theme errors"}}:</h4>
                    <ul class="gh-error-stack-list">
                        {{#foreach errorDetails}}
                        <li>
                            <h5 class="gh-error-stack-function">{{{rule}}}</h5>

                            {{#foreach failures}}
                            <span class="gh-error-stack-file"><strong>Ref:</strong> {{ref}}</span><br>
                            <span class="gh-error-stack-file"><strong>Message:</strong> {{message}}</span>
                            {{/foreach}}
                        </li>
                        {{/foreach}}
                    </ul>
                </section>
                {{/if}}

            </section>

        </div>
    </section>

</main>

<footer class="gh-foot">
    <div class="gh-foot-inner gh-container">
        <div class="gh-foot-bottom">
            <div class="gh-foot-meta">
                &copy; {{date format="YYYY"}} {{@site.title}} &bull; {{t "Powered by"}} <a href="https://ghost.org" target="_blank" rel="noopener">Ghost</a>
            </div>
        </div>
    </div>
</footer>

</div>

{{ghost_foot}}

</body>
</html>