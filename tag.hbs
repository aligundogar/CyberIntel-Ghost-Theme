{{!< default}}

<div class="gh-page">
    <div class="gh-container">

        {{#tag}}
        <header class="gh-page-head">
            <div class="cyber-tag-icon" aria-hidden="true">
                {{> "icons/shield"}}
            </div>

            <h1>{{name}}</h1>

            <p>
                {{#if description}}
                    {{description}}
                {{else}}
                    {{plural ../pagination.total empty=(t "No posts found") singular=(t "1 post") plural=(t "% posts")}}
                {{/if}}
            </p>

            {{#if feature_image}}
                <img class="gh-page-image" src="{{feature_image}}" alt="{{name}}" />
            {{/if}}

        </header>
        {{/tag}}

        <div class="gh-postfeed">
        {{#foreach posts}}

            {{> "card"}}

        {{/foreach}}
        </div>

    </div>
</div>
